PORT=4000

# For local MongoDB (default)
MONGO_URI=mongodb://localhost:27017/cartzio-handmade

# For MongoDB Atlas (cloud), use this format instead:
# MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/cartzio-handmade?retryWrites=true&w=majority

# For MongoDB Compass connection, use the connection string from Compass:
# Example: mongodb://localhost:27017/cartzio-handmade
# Or with auth: mongodb://username:password@localhost:27017/cartzio-handmade